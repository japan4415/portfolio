---
import { Picture } from 'astro:assets';
import photo from '../assets/images/photo2.png';
---

<div class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-3">
      <div class="flex flex-col items-center">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[192, 384]}
          width={384}
          sizes="192px"
          quality={80}
          alt="加藤慶彦のプロフィール写真"
          class="mx-auto h-48 w-48 rounded-full object-cover shadow-xl"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <h1 class="mt-6 text-center text-4xl font-bold">加藤慶彦</h1>
        <p class="text-center text-lg text-gray-600">Yoshihiko Kato</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:col-span-2 md:grid-cols-2">
        <div class="rounded-xl bg-white p-6 shadow-md">
          <h2 class="mb-3 text-xl font-bold text-blue-600">好きなもの</h2>
          <ul class="list-disc space-y-1 pl-5 leading-relaxed text-gray-600">
            <li>クラフトビール（特にHazy IPA）</li>
          </ul>
        </div>
        <div class="rounded-xl bg-white p-6 shadow-md">
          <h2 class="mb-3 text-xl font-bold text-blue-600">学歴</h2>
          <ul class="space-y-1 leading-relaxed text-gray-600">
            <li>2023年 慶應義塾大学理工学部開放環境科学専攻博士後期課程単位取得退学</li>
            <li>2018年 電気通信大学情報理工学研究科博士前期課程卒業</li>
            <li>2016年 電気通信大学情報理工学部卒業</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
